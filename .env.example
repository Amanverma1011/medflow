# Copy to .env and adjust. Never commit a real .env.

APP_ENV=development
HOSPITAL_NAME=MedFlow General Hospital
# IANA timezone the hospital operates in ("today" and hour-of-day analytics use it)
HOSPITAL_TZ=UTC

# --- Database -------------------------------------------------------------
POSTGRES_PASSWORD=medflow
POSTGRES_PORT=5433
# Used when running the backend outside Docker. Compose overrides the host to "postgres".
DATABASE_URL=postgresql+psycopg://medflow:medflow@localhost:5433/medflow
# SELECT-only role the Operations Copilot runs generated SQL as
ANALYTICS_DB_PASSWORD=medflow_ro

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5174,http://localhost:8080

# --- AI providers (any OpenAI-compatible API) ------------------------------
# Leave the keys blank to run in demo mode: a deterministic local embedder and
# an extractive answer composer. The RAG pipeline itself is identical.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Must match the embedding model. Changing it requires a new migration + re-ingest.
VECTOR_DIMENSION=384

# --- RAG tuning -------------------------------------------------------------
RAG_ALPHA=0.6
RAG_BETA=0.4
RAG_TOP_K=20
RAG_FINAL_K=5
RAG_MIN_CONFIDENCE=0.42

# --- Demo -------------------------------------------------------------------
# Seed the demo hospital automatically when the database is empty
AUTO_SEED=true
DEMO_PASSWORD=MedFlow#2026
